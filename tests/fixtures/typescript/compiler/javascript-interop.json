  {
    "name": "CommonJS factory setter preserves recognized JSDoc write types",
    "extension": "cjs",
    "old": "function create(){let state=1;return {get api(){return state},\n/** @param {number|string} value */\nset api(value){state=Number(value)}}}module.exports=create();",
